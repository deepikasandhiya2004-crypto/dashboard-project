generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(cuid())
  name             String
  email            String          @unique
  password         String
  role             String          @default("member") // admin | member
  roleId           String?
  roleRef          Role?           @relation(fields: [roleId], references: [id], onDelete: SetNull)
  resetToken       String?         @unique
  resetTokenExpiry DateTime?
  departmentId     String?
  department       Department?     @relation(fields: [departmentId], references: [id])
  createdAt        DateTime        @default(now())
  projectMembers   ProjectMember[]
  notificationSettings NotificationSetting?
  auditLogs AuditLog[]
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
}
model Service {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  category    String   @default("general")
  price       Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Project {
  id         String            @id @default(cuid())
  name       String
  client     String?
  status     String            @default("planning") // planning | active | completed
  progress   Int               @default(0)
  startDate  DateTime?
  dueDate    DateTime?
  createdAt  DateTime          @default(now())
  tasks      Task[]
  milestones Milestone[]
  team       ProjectMember[]
  files      ProjectFile[]
  feedbacks  ClientFeedback[]
  activities ProjectActivity[]
}

model Task {
  id        String    @id @default(cuid())
  title     String
  assignee  String?
  priority  String    @default("medium") // low | medium | high | urgent
  status    String    @default("todo") // todo | in_progress | done
  startDate DateTime?
  dueDate   DateTime?
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

model Milestone {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  status    String    @default("pending") // pending | completed
  dueDate   DateTime?
  createdAt DateTime  @default(now())
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  role      String   @default("Member")
  createdAt DateTime @default(now())

  @@unique([projectId, name])
}

model ProjectFile {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  size       String?
  type       String?
  uploadedAt DateTime @default(now())
}

model ClientFeedback {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientName String
  rating     Int      @default(5)
  comment    String
  status     String   @default("reviewed") // pending | reviewed
  createdAt  DateTime @default(now())
}

model ProjectActivity {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action    String
  user      String
  createdAt DateTime @default(now())
}

// Module 8: Marketing Models
model Campaign {
  id        String          @id @default(cuid())
  name      String
  status    String          @default("planning") // planning | active | completed | paused
  startDate DateTime?
  endDate   DateTime?
  budget    Float?          @default(0)
  createdAt DateTime        @default(now())
  leads     MarketingLead[]
}

model MarketingLead {
  id         String    @id @default(cuid())
  name       String
  email      String?
  source     String    @default("website") // website | referral | social | ad | email
  status     String    @default("new") // new | contacted | qualified | converted | lost
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
}

model MarketingContent {
  id          String    @id @default(cuid())
  title       String
  type        String    @default("blog") // blog | video | social | email | case_study
  status      String    @default("draft") // draft | review | published
  publishDate DateTime?
  author      String?
  createdAt   DateTime  @default(now())
}

model SocialPost {
  id            String    @id @default(cuid())
  platform      String    @default("linkedin") // linkedin | twitter | instagram | facebook
  content       String
  status        String    @default("draft") // draft | scheduled | published
  scheduledDate DateTime?
  createdAt     DateTime  @default(now())
}

// Module 9: Calendar Models
model Meeting {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  startTime String
  endTime   String
  attendees String?
  location  String?
  createdAt DateTime @default(now())
}

model FollowUp {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  client    String?
  notes     String?
  status    String   @default("pending") // pending | completed
  createdAt DateTime @default(now())
}

// CRM Models from origin/main
model Lead {
  id         String     @id @default(cuid())
  name       String
  email      String?
  phone      String?
  source     String?
  status     String     @default("new") // new | contacted | qualified | proposal | won | lost
  value      Int        @default(0)
  ownerId    String?
  activities Activity[]
  createdAt  DateTime   @default(now())
}

model Client {
  id             String          @id @default(cuid())
  name           String
  email          String?
  phone          String?
  company        String?
  deals          Deal[]
  proposals      Proposal[]
  activities     Activity[]
  quotations     Quotation[]
  invoices       Invoice[]
  payments       Payment[]
  transactions   Transaction[]
  createdAt      DateTime        @default(now())
  supportTickets SupportTicket[]
}

model Deal {
  id         String     @id @default(cuid())
  title      String
  clientId   String
  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  value      Int        @default(0)
  stage      String     @default("prospecting") // prospecting | negotiation | won | lost
  closeDate  DateTime?
  proposals  Proposal[]
  activities Activity[]
  createdAt  DateTime   @default(now())
}

model Proposal {
  id        String   @id @default(cuid())
  title     String
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id])
  value     Int      @default(0)
  status    String   @default("draft") // draft | sent | accepted | rejected
  createdAt DateTime @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  type      String // call | email | meeting | note
  subject   String
  notes     String?
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Module 10: Finance Models

model Quotation {
  id          String          @id @default(cuid())
  quotationNo String          @unique
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  issueDate   DateTime        @default(now())
  validUntil  DateTime?
  status      String          @default("draft") // draft | sent | accepted | rejected | expired
  subtotal    Float           @default(0)
  discount    Float           @default(0)
  tax         Float           @default(0)
  total       Float           @default(0)
  notes       String?
  items       QuotationItem[]
  invoice     Invoice?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description String
  quantity    Int       @default(1)
  unitPrice   Float     @default(0)
  total       Float     @default(0)
  createdAt   DateTime  @default(now())
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNo     String        @unique
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quotationId   String?       @unique
  quotation     Quotation?    @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  status        String        @default("draft") // draft | sent | unpaid | partially_paid | paid | overdue | cancelled
  subtotal      Float         @default(0)
  discount      Float         @default(0)
  tax           Float         @default(0)
  total         Float         @default(0)
  paidAmount    Float         @default(0)
  balanceAmount Float         @default(0)
  notes         String?
  items         InvoiceItem[]
  payments      Payment[]
  transactions  Transaction[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int      @default(1)
  unitPrice   Float    @default(0)
  total       Float    @default(0)
  createdAt   DateTime @default(now())
}

model Payment {
  id          String   @id @default(cuid())
  paymentNo   String   @unique
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Float
  paymentDate DateTime @default(now())
  method      String   @default("bank_transfer") // cash | bank_transfer | upi | card | cheque | other
  reference   String?
  notes       String?
  createdAt   DateTime @default(now())
}

model Transaction {
  id              String   @id @default(cuid())
  transactionNo   String   @unique
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  invoiceId       String?
  invoice         Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  type            String // income | expense
  category        String
  amount          Float
  description     String?
  transactionDate DateTime @default(now())
  reference       String?
  createdAt       DateTime @default(now())
}

model SupportTicket {
  id       String  @id @default(cuid())
  ticketNo String  @unique
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  subject     String
  description String?
  status      String  @default("open")
  priority    String  @default("medium")
  category    String  @default("general")
  assignedTo  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model NotificationSetting {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailNotifications    Boolean  @default(true)
  taskNotifications     Boolean  @default(true)
  leadNotifications     Boolean  @default(true)
  projectNotifications  Boolean  @default(true)
  paymentNotifications  Boolean  @default(true)
  supportNotifications  Boolean  @default(true)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
model Integration {
  id          String   @id @default(cuid())
  name        String   @unique
  provider    String
  description String?
  enabled     Boolean  @default(false)
  configured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  module      String
  description String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}