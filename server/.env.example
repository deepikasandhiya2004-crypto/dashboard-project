DATABASE_URL="your-neon-postgres-connection-string"
JWT_SECRET="your-jwt-secret"
PORT=4000

# Frontend URL used to build the password reset link
APP_URL="http://localhost:5173"

# SMTP credentials for sending real emails (e.g. Gmail App Password, or a
# provider like Resend/Mailgun/SendGrid's SMTP endpoint)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="youraddress@gmail.com"
SMTP_PASS="your-app-password"
MAIL_FROM="INFINIQ CRM <youraddress@gmail.com>"